{
  "id": "./",
  "name": "StudyForge",
  "short_name": "StudyForge",
  "description": "Local-first StudyForge flashcards with no-scroll auto-fit cards, compositor-only swipe grading, instant-ready images, Classic and spaced-repetition modes, LaTeX, topics, tags, progress, and offline PWA support.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0a092d",
  "theme_color": "#0b0a2b",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false
}
